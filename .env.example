# ============================================================
# LaputaMediaCenter 環境變數配置模板
# 複製此文件為 .env.local 並按需填寫
# ============================================================
# 規則：
# - 默認 Provider 全部「免費 / 免費額度」，不填任何 key 也能跑通
# - 付費 key 留空表示用該 Provider 的免費備援
# - 個人路徑 / Skill 目錄請填自己機器的真實路徑
# ============================================================

# ----------- 基本運行 -----------

# 開發模式 / 生產模式（默認 development）
NODE_ENV=development

# 日誌級別（debug / info / warn / error）
LOG_LEVEL=info

# 鑒權系統（Phase 1 後默認關閉，朋友本地用免登錄）
AUTH_ENABLED=false

# 數據庫路徑（默認項目根 data/db.sqlite）
# DATABASE_URL=file:./data/db.sqlite

# ----------- 加密 / Session（不填則自動生成）-----------

# 64 位十六進制加密 key
# ENCRYPTION_KEY=

# 64 位十六進制 session secret
# SESSION_SECRET=

# ----------- 🟢 LLM 後端（兩階段翻譯 + 改寫腳本用）-----------

# Gemini（默認，免費額度大）—— 不填用 free 配額
# 申請：https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OpenAI（付費替代）
# OPENAI_API_KEY=

# Mistral（開源備選）
# MISTRAL_API_KEY=

# ----------- 🟢 ASR（語音轉文字）— Phase 2 集成 whisper.cpp -----------

# whisper.cpp 二進制路徑（高級用戶覆蓋）
# 不設則自動下載到 ~/.laputa/whisper/bin/<platform>/whisper-cli
# Windows x64 自動下載；macOS/Linux 請手動安裝（brew install whisper-cpp 等）後填這個
# WHISPER_CPP_PATH=

# whisper.cpp 模型大小：tiny (75MB) / base (148MB, 推薦) / small (466MB) / medium (1.5GB)
# WHISPER_CPP_MODEL=base

# whisper.cpp 工作線程數（不設則 max(cpus-2, 1)）
# WHISPER_CPP_THREADS=

# 高級：強制走 GPU/CUDA 編譯版本（用戶自編 + 填 WHISPER_CPP_PATH 才生效，Phase 2 默認 CPU）
# WHISPER_CPP_GPU=cuda

# ----------- 🔴 TTS 主力 + 🟢 免費備援 -----------

# MiniMax（用戶選定主力，中文聲線最佳）—— 不填則自動降級 Edge TTS（免費）
# 申請：https://platform.minimax.chat
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=

# ----------- 翻譯配音 Python 管線（受保護資產 translator.py 兩階段邏輯）-----------
# 注意：Phase 2 後 ASR 走 whisper.cpp（無 Python 依賴）；
# 此處 Python 僅供 translator.py 使用（系統 Python ≥3.9 即可，不需要 GPT-SoVITS 環境）。
# DUBBING_SKILL_DIR=
# DUBBING_PYTHON_EXE=
# DUBBING_RVC_PYTHON_EXE=
# DUBBING_SCRIPT_ARG_MODE=detect

# ----------- 素材吸收 / 預處理 -----------

# YouTube / 視頻下載
# INGEST_FFMPEG_EXE=ffmpeg
# INGEST_YTDLP_EXE=yt-dlp

# ----------- 運行時目錄（Windows 建議設置到項目外）-----------

# RUNTIME_DIR=/tmp/laputa
# TEMP_DIR=/tmp/laputa/temp
# OUTPUT_DIR=/tmp/laputa/output
