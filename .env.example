# ============================================================
# LaputaMediaCenter 環境變數配置模板
# 複製此文件為 .env.local 並按需填寫
# ============================================================
# 規則：
# - 默認 Provider 全部「免費 / 免費額度」，不填任何 key 也能跑通
# - 付費 key 留空表示用該 Provider 的免費備援
# - 個人路徑 / Skill 目錄請填自己機器的真實路徑
# ============================================================

# ----------- 基本運行 -----------

# 開發模式 / 生產模式（默認 development）
NODE_ENV=development

# 日誌級別（debug / info / warn / error）
LOG_LEVEL=info

# 鑒權系統（Phase 1 後默認關閉，朋友本地用免登錄）
AUTH_ENABLED=false

# 數據庫路徑（默認項目根 data/db.sqlite）
# DATABASE_URL=file:./data/db.sqlite

# ----------- 加密 / Session（不填則自動生成）-----------

# 64 位十六進制加密 key
# ENCRYPTION_KEY=

# 64 位十六進制 session secret
# SESSION_SECRET=

# ----------- 🟢 LLM 後端（兩階段翻譯 + 改寫腳本用）-----------

# Gemini（默認，免費額度大）—— 不填用 free 配額
# 申請：https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OpenAI（付費替代）
# OPENAI_API_KEY=

# Mistral（開源備選）
# MISTRAL_API_KEY=

# ----------- 🟢 ASR（語音轉文字）-----------

# whisper.cpp 二進制路徑（默認首選；Phase 2 集成）
# WHISPER_CPP_PATH=

# Whisper 模型大小（tiny / base / small / medium / large）
# WHISPER_MODEL=base

# ----------- 🔴 TTS 主力 + 🟢 免費備援 -----------

# MiniMax（用戶選定主力，中文聲線最佳）—— 不填則自動降級 Edge TTS（免費）
# 申請：https://platform.minimax.chat
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=

# ----------- 翻譯配音 Python 管線（保留 translator.py 兩階段）-----------
# Phase 0 階段沿用前身項目的 Python skill 目錄。
# 將下方路徑改成你自己機器上的真實路徑。
# DUBBING_SKILL_DIR=
# DUBBING_PYTHON_EXE=
# DUBBING_RVC_PYTHON_EXE=
# DUBBING_SCRIPT_ARG_MODE=detect

# ----------- 素材吸收 / 預處理 -----------

# YouTube / 視頻下載
# INGEST_FFMPEG_EXE=ffmpeg
# INGEST_YTDLP_EXE=yt-dlp

# ----------- 運行時目錄（Windows 建議設置到項目外）-----------

# RUNTIME_DIR=/tmp/laputa
# TEMP_DIR=/tmp/laputa/temp
# OUTPUT_DIR=/tmp/laputa/output
