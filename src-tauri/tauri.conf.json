{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LaputaMediaCenter",
  "version": "1.0.0",
  "identifier": "com.laputamediacenter.desktop",
  "build": {
    "frontendDist": "../dist/tauri-placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "r/l/": "laputa-desktop"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
